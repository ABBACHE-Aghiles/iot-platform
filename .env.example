# Copier en .env (jamais commité). Toutes les valeurs ci-dessous sont les valeurs par défaut du compose.

# --- Kafka
KAFKA_TOPIC=iot.mesures
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk   # identifiant KRaft (base64 de 22 caractères)

# --- MongoDB
MONGO_URL=mongodb://service-db:27017/iot

# --- Producteur
NB_CAPTEURS=10          # nombre de capteurs simulés
INTERVAL_MS=500         # cadence d'émission
ANOMALY_EVERY_S=45      # une anomalie injectée au moins toutes les 45 s (spec : >= 1 par minute)

# --- Spark
SPARK_REPLICAS=1        # nombre d'instances ; à aligner sur --scale service-spark=N

ANOMALY_DETECTOR=sigma  # bonus : "sigma" (seuil +/-2 sigma, spécification 3.2) ou "ewma" (moyenne/écart-type exponentiels)

# --- Airflow
DAILY_MIN_MEASURES=1000 # volume minimal quotidien attendu (quality_check)
RETRY_DELAY_S=30        # délai initial entre deux tentatives (backoff exponentiel)
